{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rootDir": "./",
    "outDir": "./build",
    "types": ["vitest/globals", "node"],
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "build", "coverage"]
}
